# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development   # Set to "production" for cloud deployment

# ── Cloud Mode (Render) ───────────────────────────────────────────────────────
# Required when NODE_ENV=production or RENDER=true.
# Run "npm run export-cookies" locally to get your Google session cookies,
# then paste the JSON value here (one line, no newlines).
GOOGLE_COOKIES=[{"name":"...","value":"...","domain":".google.com",...}]

# Directory where generated images are saved (cloud mode).
# Defaults to /tmp/gemini-downloads.
# Attach a Render Disk at /var/data for persistence across restarts.
DOWNLOAD_DIR=/tmp/gemini-downloads

# ── Local Mode ────────────────────────────────────────────────────────────────
# Path to your Chrome user data directory.
# Leave unset to use the OS default.
#
# Windows : C:\Users\<Name>\AppData\Local\Google\Chrome\User Data
# macOS   : /Users/<Name>/Library/Application Support/Google/Chrome
# Linux   : /home/<name>/.config/google-chrome
CHROME_USER_DATA_DIR=

# If Chrome is already running (profile locked), connect via CDP instead.
# Step 1: Launch Chrome with: --remote-debugging-port=9222
#   Windows: "C:\Program Files\Google\Chrome\Application\chrome.exe" --remote-debugging-port=9222
#   Mac:     /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --remote-debugging-port=9222
#   Linux:   google-chrome --remote-debugging-port=9222
# Step 2: Set this variable and restart the app:
CHROME_CDP_URL=http://localhost:9222
